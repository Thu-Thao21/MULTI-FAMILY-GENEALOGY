# Frontend Environment Variables
VITE_API_BASE_URL=http://localhost:8000/api

# Firebase Web Config (DEV Project Client Configuration)
# Lưu ý: Bộ cấu hình Web Config dưới đây dùng cho dự án DEV chung của nhóm.
# Tuyệt đối KHÔNG đưa Service Account, Private Key hoặc Facebook App Secret vào đây.
VITE_FIREBASE_API_KEY=<DEV_WEB_API_KEY>
VITE_FIREBASE_AUTH_DOMAIN=<DEV_PROJECT_ID>.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=<DEV_PROJECT_ID>
VITE_FIREBASE_STORAGE_BUCKET=<DEV_PROJECT_ID>.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=<DEV_SENDER_ID>
VITE_FIREBASE_APP_ID=<DEV_APP_ID>


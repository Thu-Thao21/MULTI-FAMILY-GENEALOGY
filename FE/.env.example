# Đây là file mẫu cho các biến môi trường của Frontend (Vite)
# Copy file này thành .env hoặc .env.local và thay đổi giá trị cho phù hợp

# URL tuyệt đối của Backend API (BE MFGMS-AI, tiền tố /api/v1; dev chạy cổng 8001)
VITE_API_BASE_URL=http://localhost:8001/api/v1

# Tên ứng dụng
VITE_APP_NAME=Multi Family Genealogy

# Các khóa cấu hình bên thứ 3 (Ví dụ: Firebase, Google Analytics...)
# VITE_FIREBASE_API_KEY=your_api_key_here
